#!/usr/bin/env bash

# Database Connection
DATABASE_URL="postgresql://devuser:devpass@127.0.0.1:55432/devdb?sslmode=disable"

# Admin User Configuration (Created on first startup)
ADMIN_PASSWORD="your_secure_admin_password"
ADMIN_EMAIL="admin@example.com"
ADMIN_USER="System Admin"

# OpenID Connect (OIDC) Configuration (Optional)
# Synced into app_settings on startup when DB values are empty.
OIDC_ISSUER="https://your-oidc-auth-provider.com"
OIDC_CLIENT_ID="your-oidc-client-id"
OIDC_CLIENT_SECRET="your-oidc-client-secret"
OIDC_REDIRECT_URL="http://localhost:3000/api/auth/oidc/callback"
# OIDC_ADMIN_GROUP="claimctl-admins"
# OIDC_GROUPS_CLAIM="groups"

# Application Settings
FRONTEND_URL="http://localhost:5173"

# Telemetry Configuration (Optional)
# OTEL_TRACES_EXPORTER=stdout
# OTEL_METRICS_EXPORTER=stdout

# Security Settings
ENABLE_CSRF=true
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=""
# All replicas must use the same base64-encoded 32-byte key.
# Production compose requires an explicit value; never rotate it casually.
APP_ENCRYPTION_KEY=""
# Production compose also requires DB_PASSWORD and a verified PG18 layout.
# DB_USER=claimctl
# DB_PASSWORD=<strong database password>
# DB_NAME=claimctl
# POSTGRES_PGDATA=/var/lib/postgresql/18/docker
# TRUSTED_INGRESS_CIDR=<CIDR of the TLS ingress seen by frontend Nginx>

# Health probe egress is denied until explicitly configured.
HEALTH_CHECK_ALLOWED_CIDRS=""
HEALTH_CHECK_ALLOWED_PORTS=""
# Private infrastructure example; tailor these to your deployment.
# HEALTH_CHECK_ALLOWED_CIDRS="10.20.0.0/16,192.168.50.0/24"
# HEALTH_CHECK_ALLOWED_PORTS="80,443,8080,22"
